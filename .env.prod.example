# Non-secret production settings. Real secrets come from AWS Secrets Manager,
# exported by ops/export_secrets.py to /run/parent-check/current (see DEPLOY.md).
# Never add API keys, DB passwords or SECRET_KEY here.
POSTGRES_USER=parentcheck
POSTGRES_DB=parentcheck
# Match these names when invoking export_secrets.py --db-user/--db-name.
SECRETS_DIRECTORY=/run/parent-check/current
SITE_ADDRESS=
# The browser frontend origin only. CORS does not authenticate callers.
FRONTEND_ORIGIN=http://localhost:3000
