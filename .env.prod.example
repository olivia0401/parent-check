# Copy this to `.env` ON THE SERVER and fill in real values. NEVER commit .env.
# (.env is already gitignored.)

# --- PostgreSQL ---
POSTGRES_USER=parentcheck
POSTGRES_PASSWORD=CHANGE-ME-long-random-string
POSTGRES_DB=parentcheck

# --- Flask ---
# Production mode: the app refuses to start without SECRET_KEY and sets the
# session cookie Secure flag. docker-compose.prod.yml defaults this to production.
APP_ENV=production
# Required. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-long-random-string

# Optional: enables the AI/RAG path. Leave blank to run the rule engine only.
GEMINI_API_KEY=

# --- Public hostname for auto-HTTPS ---
# A DNS name pointing at the EC2 public IP, e.g. a DuckDNS name
# (yourname.duckdns.org), or with no domain at all: a.b.c.d.sslip.io
SITE_ADDRESS=
