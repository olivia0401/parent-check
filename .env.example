# Copy to .env and fill in (.env is gitignored and never committed).
# For the EC2 production stack use .env.prod.example instead.

# Session-cookie signing key. Optional locally (a dev key is used), REQUIRED
# when APP_ENV=production. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "production" on a real deployment: the app then refuses to start
# without SECRET_KEY and marks session cookies Secure (HTTPS only).
# APP_ENV=production

# How many reverse proxies sit in front of the app and append X-Forwarded-For
# (Caddy on EC2 = 1). Used to find the real client IP for rate limiting.
# TRUSTED_PROXY_HOPS=1

# Data layer: PostgreSQL + pgvector. The default matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://parentcheck:parentcheck@localhost:5432/parentcheck

# Redis: shared rate limiting. The default matches docker-compose.yml.
REDIS_URL=redis://localhost:6379/0

# Optional region build. uk = UK (159 / Action Fraud / UK GDPR, default);
# cn = China (96110 / 110 / PIPL).
REGION=uk

# Optional Gemini API key (free tier). Enables the AI second opinion, the RAG
# knowledge base and screenshot OCR. When set, submitted text and screenshots
# are sent to Google Gemini. Without it the app runs on the rule engine only.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional independent verifier agent (second, escalate-only review). On by
# default (1). Each successful analysis makes one extra LLM call; set 0 to turn
# it off on a tight free tier (the analyst verdict still applies).
ENABLE_VERIFIER=1

# Optional Azure AI stack - switches providers without code changes.
#   - Azure OpenAI: with ENDPOINT + API_KEY set, embeddings and plain text
#     generation use Azure OpenAI instead of Gemini; tool-calling and image OCR
#     stay on Gemini. Use a text-embedding-3-* deployment (768 dims, to match the
#     pgvector column). After switching provider, re-seed the knowledge base with
#     the same provider (vectors are not comparable across models).
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2024-10-21
#   - Azure Document Intelligence: when set, screenshot OCR uses prebuilt-read
#     (see ocr.py); otherwise it falls back to Gemini vision.
# AZURE_DOC_INTEL_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
# AZURE_DOC_INTEL_KEY=

# Optional: any non-empty value enables the local learned classifier (off by
# default; needs requirements-ml.txt - see semantic.py).
# SEMANTIC_MODEL=1

# Render sets RENDER=true automatically, which is also treated as production.
