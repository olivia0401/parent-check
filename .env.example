# 复制成 .env 并填好（.env 已被 .gitignore 忽略，不会提交）。
# 部署到 Render 时，在服务的 Environment 里设这些。

# 必填（生产）：用于签名 session cookie 的随机密钥。
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 数据层：PostgreSQL + pgvector 连接串。本地用 docker-compose 时无需改动。
DATABASE_URL=postgresql+psycopg2://parentcheck:parentcheck@localhost:5432/parentcheck

# Redis：分布式限流 / 缓存。本地用 docker-compose 时无需改动。
REDIS_URL=redis://localhost:6379/0

# 可选：地区版本。uk = 英国（159 / Action Fraud / GDPR，默认）；cn = 中国（96110 / 110 / PIPL）。
REGION=uk

# 可选：Gemini API key（免费额度）。设置后会启用 AI 二次分析 + RAG 知识库。
# 不设置的话，应用照常运行，只是没有这一步。
# 申请地址：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 可选：独立复核 agent（多智能体第二道把关）。默认开启（1）。
# 分析员给出判断后，会有一个独立的 verifier agent 再复核一次，只能上调风险、绝不下调。
# 每次成功分析会多一次 LLM 调用；免费额度紧张时可设 0 关闭（分析员判断照常生效）。
ENABLE_VERIFIER=1

# 可选：Azure AI 栈。设置后应用改跑在 Azure 上，无需改代码。
#   - Azure OpenAI：设了 ENDPOINT + API_KEY 后，embedding 和文本生成改走 Azure
#     OpenAI（替代 Gemini）；工具调用和图片 OCR 仍走 Gemini。embedding 用
#     text-embedding-3-* 部署（维度固定 768，匹配 pgvector 列）。
#     注意：切换 provider 后需用同一 provider 重新灌种知识库（向量不可跨模型比较）。
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2024-10-21
#   - Azure Document Intelligence：设了之后，上传截图/文档的 OCR 走企业级
#     prebuilt-read（见 ocr.py），未设则回退到 Gemini 视觉。
# AZURE_DOC_INTEL_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
# AZURE_DOC_INTEL_KEY=

# 可选：设为任意非空值才启用本地学习型模型（默认关闭，见 README「学习型模型」）。
# SEMANTIC_MODEL=1

# Render 会自动注入 RENDER=true，用来开启 Secure cookie；本地不用设。
